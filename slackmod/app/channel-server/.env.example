# Got this file inside the SlackMod kit (slackmod/app/channel-server/)? Do NOT copy it by
# hand: slackmod/install.sh writes one .env per bot under ~/.slackmod/bots/<bot>/slack/,
# and `slackmod set-token <bot>` fills in the tokens. The steps below are for running the
# bridge on its own.
#
# Copy this file to ~/.claude/channels/slack/.env (NOT into this repo) and
# fill in real values. Then lock it down:
#
#   mkdir -p ~/.claude/channels/slack
#   cp .env.example ~/.claude/channels/slack/.env
#   chmod 700 ~/.claude/channels/slack
#   chmod 600 ~/.claude/channels/slack/.env
#   $EDITOR ~/.claude/channels/slack/.env
#
# server.ts also enforces/repairs these permissions at startup
# (src/config.ts ensureStateDir, loadEnv) — the manual chmod above is belt
# and suspenders for the first run, not the only line of defense.
#
# Never commit a filled-in .env. Never paste real values into chat with an
# AI agent, a code review, or a bug report — see "Token handling" in the bridge
# README.md (in the SlackMod kit: `slackmod set-token <bot>`, slackmod/README.md step 7).

# Bot User OAuth Token from your Slack app's "OAuth & Permissions" page.
# Starts with xoxb-.
SLACK_BOT_TOKEN=xoxb-REPLACE-ME

# App-Level Token from your Slack app's "Basic Information" page, with the
# connections:write scope. Starts with xapp-. This is what lets the bridge
# use Socket Mode instead of exposing a public webhook.
SLACK_APP_TOKEN=xapp-REPLACE-ME

# The Slack user ID (not username) of the single person allowed to talk to
# this bridge — messages, @mentions, and permission-approval replies from
# anyone else are silently ignored. Find yours: Slack profile -> "..." ->
# "Copy member ID". Looks like UXXXXXXXXXX.
ALLOWED_SLACK_USER_ID=UXXXXXXXXXX

# The Slack channel ID this bridge listens in and replies to — the bot must
# be invited to this channel. Messages from any other channel the bot can
# see (e.g. it was invited elsewhere later) are ignored. Find it: open the
# channel in Slack -> "..." -> "Copy channel ID". Looks like CXXXXXXXXXX.
# One or more channel ids, comma-separated (e.g. C0123,C0456). The first id is the primary channel (outbound fallback).
SLACK_CHANNEL_ID=CXXXXXXXXXX
# Add a trailing `*` (e.g. CXXXXXXXXXX,*) to also listen in every channel the bot is invited to.

# Optional: the emoji this bot reacts with the moment it accepts an inbound (its
# per-bot read receipt, so a broadcast shows at a glance which bots got it).
# Emoji name without colons. Unset = eyes.
#SLACK_BOT_EMOJI=eyes

# ── Optional: bot-to-bot messages ─────────────────────────────────────────
# Leave BOTH unset for the default behavior: every bot-authored message is
# dropped (bots cannot talk to this bridge at all).

# Comma-separated Slack *user* ids (U…, not B…) of OTHER bridge bots allowed
# to talk to this bot. A listed bot still must @-mention this bot and cannot
# use DMs. Unset/empty = bots fully blocked (legacy behavior). There is no
# chain-limit setting: a bot is let through only when it @-mentions this bot and
# is on the allowlist; the volume cap below is a separate, per-sender limit.
#ALLOWED_SLACK_BOT_USER_IDS=UXXXXXXXXXX,UXXXXXXXXXX

# Volume cap per allowed peer bot. A broken or hijacked peer that
# keeps posting would otherwise reach the session on every post. At most
# SLACK_PEER_BOT_RATE_MAX posts from ONE peer reach the session within any
# SLACK_PEER_BOT_RATE_WINDOW_S seconds; the rest are dropped (drop reason
# `bot-rate-limited`, one line each in the drop log) and one line per peer per
# window says so in the bridge log. It counts delivered posts only, never the
# owner's or a guest's, and a conversation at a normal pace never reaches it.
# On by default with the values below (uncomment to change). Plain whole numbers
# only; anything else is ignored and the default applies. MAX=0 switches the cap
# off (no machine limit on a peer bot, only the instructions to the session).
#SLACK_PEER_BOT_RATE_MAX=30
#SLACK_PEER_BOT_RATE_WINDOW_S=600

# ── Optional: guests (people besides the owner) ──────────────────────────────
# Leave unset for the default: only ALLOWED_SLACK_USER_ID (the owner) can talk to this bot.
# Comma-separated Slack *user* ids (U…) of other PEOPLE allowed to talk to this bot in a channel it
# listens to. A guest post passes only when it @-mentions THIS bot (no "bot already in this thread"
# shortcut), never in a DM, never as a permission approval, and its attachments are not downloaded.
# The session sees it tagged sender_role="guest" (the owner's posts carry sender_role="owner") and is
# told a guest's post is conversation only. A guest id equal to the owner id is still the owner.
# .env values take no trailing comment.
#ALLOWED_SLACK_GUEST_IDS=UXXXXXXXXXX,UXXXXXXXXXX

# ── Optional: owner-tag DM copy ─────────────────────────────────────────────
# OFF unless the first key is set. When this bot's `reply` posts to a non-DM channel/thread and the
# text tags the owner (<@ALLOWED_SLACK_USER_ID>), the bridge posts ONE copy into the owner's DM with
# this bot: line 1 = the template below, line 2 = the post's first line (mentions removed, cut to
# 120 chars; left out if it carries a hash/path/id-like "coordinate"). A post containing a secret
# pattern is never copied. A failed copy never changes the result of the original reply.
# The owner's DM with THIS bot: Slack -> the DM -> "..." -> "Copy channel ID". Looks like DXXXXXXXXXX.
#SLACK_OWNER_TAG_DM_COPY_CHANNEL=DXXXXXXXXXX
# Only if the owner differs from ALLOWED_SLACK_USER_ID:
#SLACK_OWNER_TAG_DM_COPY_USER=UXXXXXXXXXX
# .env values take no trailing comment (`KEY=value # note` would be read as part of the value and the feature stays off).
# First line of the copy; {bot} and {link} (required) are filled in. Default shown.
#SLACK_OWNER_TAG_DM_COPY_TEMPLATE=[{bot}] mentioned you in a thread — {link}

# ── Optional: drop notices ───────────────────────────────────────────────────
# Optional drop notices. A dropped bot post is always recorded (one JSONL line,
# no message body, in ~/.claude-state/bridge-drops-<bot>.jsonl); these only add
# a short reply in the same Slack thread so the sending bot learns its post did
# not arrive. Each is rate-limited to 1 per (sender, channel) per 30 minutes and
# 10 per hour (state in ~/.claude-state/bridge-drop-notice[-nomention]-<bot>.json;
# if it cannot be saved, the notice stays off). Unset = record only.
# 1 = notice a bot that @-mentions this bot but is not on the allowlist above.
#SLACK_DROP_NOTICE=1
# 1 = notice a bot that IS on the allowlist but posted without @-mentioning this
# bot. Needs the message.channels subscription (without it Slack never sends a
# post that does not mention this bot). With it, any allowed peer post that is
# not for this bot can draw the notice — the rate limit keeps it to one per
# channel per 30 minutes. In a channel shared by several bridges, turn it on for
# one or two of them only: every bridge that has it on answers the same post.
# This .env key is the only switch — the process env no longer turns it on.
# One notice per sender per thread (kept a day). If the older key
# SLACK_DROP_PILOT_NOTICE is also on, both are refused and nothing is posted.
# Emergency off for every bridge: touch ~/.claude-state/slack-drop-notice.off
# Receipts (posted / bridge-received / session-reached, no message body):
# ~/.claude-state/bridge-notice-receipts-<bot>.jsonl
# If the notice ledger (~/.claude-state/bridge-nomention-ledger-<bot>.json) cannot
# be read, the notice stays off until that file is removed.
# Turn it on for one receiving bot only — that bot's bridge .env gets the line
# below; every other bot leaves it unset. That bot's Slack app must subscribe to message.channels.
#SLACK_DROP_NOTICE_NO_MENTION=1
# Emergency off key: 1 = this notice stays off. In this .env it stops this bot;
# set in the process environment of a launcher it stops every bridge started
# from there (the same key the older SLACK_DROP_PILOT_NOTICE setting reads). Checked at bridge start.
#SLACK_DROP_PILOT_EMERGENCY_OFF=1

# ── Optional: raw receipt log (OFF unless you set it) ────────────────────────
# 1 = append one JSONL line per Slack message event to ~/.claude-state/bridge-raw-<bot>.jsonl:
# time, channel, message ts, subtype, bot yes/no, the SENDER'S SLACK USER ID, "had text" yes/no,
# file count, channel type. Never the text, files or blocks. The line is written before any
# allow/deny judgment, so it also names senders who are not allowed and posts that are then
# dropped. File 0600 (directory 0700); at 64 MiB it rotates to one `.1`, so at most ~128 MiB per
# bot. Only useful if a silence watcher reads it; leave it unset otherwise. Exactly `1` turns it
# on, and only in this .env (the process environment does not count). Unset = no file at all.
#SLACK_RAW_LOG=1

# ── On by default (older versions of this bridge behaved differently) ────────
# DM threading: a reply to a DM goes into the thread of the DM message it answers and is ALSO
# shown in the DM itself, so it still notifies. 0 = keep the reply in the thread only (no copy
# in the DM, so no notification). Channel replies are unaffected. Default shown.
#SLACK_DM_REPLY_BROADCAST=1
# Long replies (no switch): a reply over 3,500 characters is posted as several messages in
# order, cut on line boundaries with code fences kept closed; each piece is numbered (i/N) and
# every <@…> mention of the whole text is repeated on the pieces that would otherwise lack it,
# so a peer bridge does not drop the later pieces as `bot-no-mention`.
